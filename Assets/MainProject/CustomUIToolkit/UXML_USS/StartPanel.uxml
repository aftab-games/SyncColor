<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainProject/CustomUIToolkit/UXML_USS/GameUI.uss?fileID=7433441132597879392&amp;guid=67619573a6bbb084b90eb72cf6a2f346&amp;type=3#GameUI" />
    <engine:VisualElement name="StartPanel" class="panel">
        <engine:Label text="Color Sync Runner" name="TitleLabel" class="title-label" />
        <engine:Button text="Start Game" name="StartButton" class="button" />
    </engine:VisualElement>
    <engine:VisualElement name="LevelCompletePanel" class="panel">
        <engine:Label text="Level Completed" name="CompleteLabel" class="success-label" />
        <engine:Button text="Next Level" name="NextButton" class="button" />
    </engine:VisualElement>
    <engine:VisualElement name="LevelFailedPanel" class="panel">
        <engine:Label text="Level Failed" name="FailedLabel" class="fail-label" />
        <engine:Button text="Retry" name="RetryButton" class="button" />
    </engine:VisualElement>
</engine:UXML>
