.panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
    opacity: 0;
    display: none;
}

.title-label {
    font-size: 75px;
    color: rgb(5, 173, 255);
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
    top: auto;
    bottom: 500px;
}

.success-label {
    font-size: 75px;
    color: rgb(11, 184, 102);
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
    bottom: 500px;
}

.fail-label {
    font-size: 75px;
    color: rgb(121, 13, 215);
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
    bottom: 500px;
}

.button {
    font-size: 50px;
    color: white;
    -unity-font-style: bold;
    background-color: rgb(0, 123, 255);
    border-radius: 12px;
    padding: 10px 20px;
    margin-top: 10px;
    width: 400px;
    height: 150px;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-right-radius: 70px;
    border-bottom-left-radius: 70px;
    border-left-color: rgba(0, 0, 0, 0.57);
    border-right-color: rgba(0, 0, 0, 0.57);
    border-top-color: rgba(0, 0, 0, 0.57);
    border-bottom-color: rgba(0, 0, 0, 0.57);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    bottom: auto;
    top: 500px;
}

.button:hover {
    background-color: rgb(0, 86, 179);
}

.button:active {
    background-color: rgb(0, 63, 127);
}
