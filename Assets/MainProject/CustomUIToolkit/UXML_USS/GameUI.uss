/* ===== Root container ===== */
.panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.6);

    opacity: 0;
    display: none;

    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

/* ===== Labels ===== */
.title-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
}

.success-label {
    font-size: 28px;
    color: #3CCF4E; /* green */
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
}

.fail-label {
    font-size: 28px;
    color: #FF4C4C; /* red */
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-align: center;
}

/* ===== Buttons ===== */
.button {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    background-color: #007BFF;
    border-radius: 12px;
    padding: 10px 20px;
    margin-top: 10px;
}

.button:hover {
    background-color: #0056b3;
}

.button:active {
    background-color: #003f7f;
}
